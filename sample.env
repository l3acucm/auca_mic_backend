# ─────────────────────────────────────────────────────────────────────────────
# auca_mic_backend environment.
#
# Local dev:  copy to `.env` and run with
#               dotenv -f .env run -- poetry run python manage.py runserver
# Production: split between the shared `global.env` (SECRET_KEY, POSTGRES_*,
#             AWS_ACCESS_KEY/SECRET, PRODUCTION) and the app's `auca_mic.env`
#             (everything else) that docker-compose loads. This single file
#             documents every variable the app reads.
# Booleans are 0 / 1 ints.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core Django ---
SECRET_KEY=change-me-to-a-long-random-string
# Exactly one of these should be 1 in a given environment. All 0 => local dev.
DEVELOPMENT=1
STAGING=0
PRODUCTION=0
TESTING=0

# Public domain of the BACKEND/API. URL scheme is derived (https in staging/prod).
# Prod value: micauca-api.vassilyv.me
DOMAIN=localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins the React SPA calls the API from (comma-separated).
# Prod value: https://micauca.vassilyv.me
FRONTEND_ORIGINS=http://localhost:5173

# --- Database ---
# Prod: only POSTGRES_DATABASE_NAME goes in auca_mic.env — USER/PASSWORD/
# ENDPOINT/PORT are the shared postgres role from the host's global.env
# (one role for every app on that host; each app just gets its own database).
POSTGRES_DATABASE_NAME=auca_mic
POSTGRES_USER=auca_mic
POSTGRES_PASSWORD=change-me
POSTGRES_ENDPOINT=localhost
POSTGRES_PORT=5432

# --- S3-compatible object storage (stimuli images + result XLSX; STAGING/PRODUCTION only) ---
# Prod: only AWS_BUCKET_NAME goes in auca_mic.env — AWS_ACCESS_KEY/SECRET_KEY
# and S3_ENDPOINT_URL are already shared in global.env (same object storage
# account for every app; each app gets its own bucket).
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=auca-mic
S3_ENDPOINT_URL=https://hel1.your-objectstorage.com

# --- Gunicorn (optional) ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
